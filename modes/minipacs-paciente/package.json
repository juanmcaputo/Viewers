    "build:package": "yarn run build"
  },
  "peerDependencies": {
    "@minipacs/extension-report": "0.1.0",
    "@ohif/core": "3.12.17",
    "@ohif/extension-cornerstone": "3.12.17",
    "@ohif/extension-cornerstone-dicom-rt": "3.12.17",
    "@ohif/extension-cornerstone-dicom-seg": "3.12.17",
    "@ohif/extension-cornerstone-dicom-sr": "3.12.17",
    "@ohif/extension-default": "3.12.17",
    "@ohif/extension-dicom-pdf": "3.12.17",
    "@ohif/extension-dicom-video": "3.12.17",
    "@ohif/mode-basic": "3.12.17",
    "@ohif/ui-next": "3.12.17"
  },
  "dependencies": {
    "@babel/runtime": "7.28.2"
  },
  "devDependencies": {
    "webpack": "5.105.0",
    "webpack-merge": "5.10.0"
  }
