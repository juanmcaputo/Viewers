{
  "name": "@minipacs/mode-paciente",
  "version": "0.1.0",
  "description": "MiniPACS: visor del paciente (barra reducida, sin informe ni lista de mediciones)",
  "author": "MiniPACS",
  "license": "MIT",
  "private": true,
  "main": "dist/minipacs-mode-paciente.js",
  "module": "src/index.tsx",
  "engines": {
    "node": ">=14",
    "npm": ">=6",
    "yarn": ">=1.16.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ohif-mode"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
